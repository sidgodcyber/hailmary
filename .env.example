# ---------------------------------------------------------------------------
# Hailmary environment variables
# Copy this file to `.env.local` and fill in real values. NEVER commit .env.local.
# ---------------------------------------------------------------------------

# --- App branding (client-facing) ---
NEXT_PUBLIC_APP_NAME="Hailmary"

# --- Supabase project (create a free project at https://supabase.com) ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Service role key — SERVER ONLY. Full DB access, bypasses RLS. Used by the seed
# script and admin-only server actions/exports. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Where magic links redirect back to. Locally: http://localhost:3000
# In production: your deployed URL, e.g. https://hailmary.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Gravity read-API bearer token (server only) ---
# One long random secret. Generate with:  npm run gen:token
# The GET /api/export/activity endpoint requires  Authorization: Bearer <this>.
GRAVITY_EXPORT_TOKEN="generate-a-long-random-hex-string"

# --- Seed script inputs (used by `npm run seed`) ---
# Admin = you (sees/edits all tenants). Client = the Shunyethra login.
# Put your REAL login emails here in .env.local (this .env.example stays as placeholders).
ADMIN_EMAIL="admin@example.com"
SHUNYETHRA_CLIENT_EMAIL="client@example.com"
