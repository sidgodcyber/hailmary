{
  "name": "hailmary",
  "version": "0.1.0",
  "private": true,
  "description": "Hailmary — client companion portal (multi-tenant, magic-link auth, RLS-enforced isolation).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:isolation": "vitest run tests/isolation.test.ts",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "probe:storage": "tsx scripts/probe-storage.ts",
    "gen:token": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "gen:types": "supabase gen types typescript --linked > src/lib/db/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "jszip": "^3.10.1",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
